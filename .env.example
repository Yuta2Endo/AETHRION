# AETHRION - public/client-safe environment example
# Never put Robokassa passwords, signing secrets, private API keys, keystore passwords, or tokens in VITE_* variables.

VITE_APP_NAME=AETHRION
VITE_APP_SLOGAN=BUILD YOUR EMPIRE. SHAPE THE FUTURE.
VITE_APP_VERSION=0.9.0
VITE_ENV=development
VITE_DEBUG=true
VITE_LOG_LEVEL=debug

# Public API base URL for authenticated application backend (payments/status). No secrets.
VITE_API_BASE_URL=http://localhost:5173/api

# Simulation/rendering
VITE_ENABLE_SIMULATION_WORKER=true
VITE_RENDER_QUALITY=auto

# Distribution/payment policy gate (safe client hint; server remains authoritative)
# direct_distribution | google_play_eea_alternative_billing | google_play_standard_policy | web_distribution
VITE_DISTRIBUTION_MODE=direct_distribution
VITE_PAYMENTS_ENABLED=false

# Yandex Ads (public placement identifiers only)
VITE_ADS_ENABLED=true
VITE_ADS_MODE=development
# Use official Yandex demo rewarded placement ID in development; never fabricate production IDs.
VITE_YANDEX_REWARDED_AD_UNIT_ID=
