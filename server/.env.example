# AETHRION payments server (server-side secrets only - NEVER put in client VITE_* vars)
PORT=8787
DB_PATH=./db/payments.sqlite
NODE_ENV=development

# Auth: x-account-id is a LOCAL DEVELOPMENT STUB ONLY (not secure identity).
# For production/real deployment, integrate real authentication and set REQUIRE_REAL_AUTH=true.
ALLOW_INSECURE_AUTH_STUB=true
REQUIRE_REAL_AUTH=false

# Robokassa merchant credentials (TEST or production). Leave empty to run server in unconfigured mode.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=true
ROBOKASSA_PAYMENT_URL=https://auth.robokassa.ru/Merchant/Index.aspx
